
facts = {"fever(Ravi)", "cough(Ravi)"}

rules = [
    ({"fever(Ravi)", "cough(Ravi)"}, "flu(Ravi)"),
    ({"flu(Ravi)"}, "prescribe_medicine(Ravi)")
]

def forward_chaining(facts, rules):
    changed = True

    while changed:
        changed = False
        for conditions, conclusion in rules:
            if conditions.issubset(facts) and conclusion not in facts:
                facts.add(conclusion)
                print("Inferred:", conclusion)
                changed = True

forward_chaining(facts, rules)

print("Final Facts:", facts)
